{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Create virtual environment",
            "type": "process",
            "command": "py",
            "args": ["-3", "-m", "venv", ".venv"],
            "problemMatcher": []
        },
        {
            "label": "Install dependencies",
            "type": "process",
            "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
            "args": ["-m", "pip", "install", "-e", ".[gemini,heic,faces,dev]"],
            "dependsOn": "Create virtual environment",
            "problemMatcher": []
        },
        {
            "label": "Run tests",
            "type": "process",
            "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
            "args": ["-m", "pytest", "-q"],
            "group": { "kind": "test", "isDefault": true },
            "problemMatcher": []
        },
        {
            "label": "Build MediaNamer.exe",
            "type": "process",
            "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
            "args": ["-m", "PyInstaller", "--noconfirm", "--noconsole", "--onefile",
                     "--name", "MediaNamer", "run_media_namer.py"],
            "dependsOn": "Install PyInstaller",
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": []
        },
        {
            "label": "Install PyInstaller",
            "type": "process",
            "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
            "args": ["-m", "pip", "install", "pyinstaller"],
            "problemMatcher": []
        }
    ]
}
